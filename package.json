{
  "name": "krs-banana-wholesale-billing",
  "version": "1.0.0",
  "description": "Offline Desktop Billing & POS Application for Wholesale Banana Business",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:electron\"",
    "dev:backend": "node server/index.js",
    "dev:frontend": "vite",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env NODE_ENV=development VITE_DEV_SERVER_URL=http://localhost:5173 env -u ELECTRON_RUN_AS_NODE electron .",
    "build:frontend": "vite build",
    "build:app": "npm run build:frontend && electron-builder",
    "build:mac": "npm run build:frontend && electron-builder --mac",
    "build:win": "npm run build:frontend && electron-builder --win",
    "build:linux": "npm run build:frontend && electron-builder --linux",
    "start": "env -u ELECTRON_RUN_AS_NODE electron ."
  },
  "keywords": [
    "banana",
    "billing",
    "pos",
    "malayalam",
    "electron",
    "wholesale",
    "kerala"
  ],
  "author": "KRS Banana Wholesale",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "better-sqlite3": "^13.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.72.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.6.2",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jimp": "^1.6.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^3.4.17",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.krs.bananabilling",
    "productName": "KRS Banana Wholesale Billing",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "server/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.business",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office"
    }
  }
}
